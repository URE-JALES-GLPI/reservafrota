{# Formulário de cadastro/edição de motorista (com foto, CNH, telefone) #}
{% set is_new = item.isNewItem() %}
{% set can_edit = can_edit is defined ? can_edit : false %}
{% set readonly = not can_edit and not is_new %}

<div class="reservafrota-header-actions" style="margin-bottom: 15px;">
    <a class="reservafrota-back" href="{{ web_dir }}/front/driver.php"><i class="ti ti-arrow-left"></i> {{ __('Voltar para Motoristas', 'reservafrota') }}</a>
</div>

<div class="reservafrota-carform">
    <form method="post" action="{{ web_dir }}/front/driver.form.php" enctype="multipart/form-data">
        {% if not is_new %}
            <input type="hidden" name="id" value="{{ item.fields['id'] }}">
        {% endif %}
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

        <div class="row">
            <div class="col-12 col-md-4 reservafrota-carform__photo">
                <div class="reservafrota-photo-preview">
                    {% if picture_url %}
                        <img src="{{ picture_url }}" alt="{{ item.fields['name'] }}">
                    {% else %}
                        <div style="display:flex;align-items:center;justify-content:center;height:160px;background:#f1f5f9;border-radius:12px;">
                            <i class="ti ti-steering-wheel" style="font-size:4rem;color:#94a3b8;"></i>
                        </div>
                    {% endif %}
                </div>
                <label class="form-label">{{ __('Foto do motorista', 'reservafrota') }}</label>
                <input type="file" id="driver-picture" name="picture" accept="image/*" class="reservafrota-imgfile" {% if readonly %}disabled{% endif %} hidden>
                <div class="reservafrota-imgname text-muted">{{ __('Use o botão "Adicionar Imagem" abaixo.', 'reservafrota') }}</div>
                <small class="text-muted">{{ __('JPG, PNG, WEBP ou GIF.', 'reservafrota') }}</small>
                {% if can_edit %}
                    <label for="driver-picture" class="reservafrota-addimg" style="margin-top:0.8rem;width:100%;justify-content:center;"><i class="ti ti-photo-plus"></i> {{ __('Adicionar Imagem', 'reservafrota') }}</label>
                {% endif %}
            </div>

            <div class="col-12 col-md-8">
                <div class="mb-3">
                    <label class="form-label" for="driver-name">{{ __('Nome', 'reservafrota') }} <span style="color:#d6336c;">*</span></label>
                    <input type="text" class="form-control" id="driver-name" name="name" value="{{ item.fields['name'] }}" required placeholder="{{ __('Ex.: João Silva', 'reservafrota') }}" {% if readonly %}readonly{% endif %}>
                </div>

                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label" for="driver-cnh">{{ __('CNH', 'reservafrota') }}</label>
                        <input type="text" class="form-control" id="driver-cnh" name="cnh" value="{{ item.fields['cnh'] }}" placeholder="{{ __('Nº da CNH', 'reservafrota') }}" {% if readonly %}readonly{% endif %}>
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label" for="driver-phone">{{ __('Telefone', 'reservafrota') }}</label>
                        <input type="text" class="form-control" id="driver-phone" name="phone" value="{{ item.fields['phone'] }}" placeholder="(00) 00000-0000" {% if readonly %}readonly{% endif %}>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="driver-active">{{ __('Disponível', 'reservafrota') }}</label>
                    <select class="form-select" id="driver-active" name="is_active" {% if readonly %}disabled{% endif %}>
                        <option value="1" {{ item.fields['is_active'] ? 'selected' : '' }}>{{ __('Disponível', 'reservafrota') }}</option>
                        <option value="0" {{ not item.fields['is_active'] ? 'selected' : '' }}>{{ __('Indisponível', 'reservafrota') }}</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="driver-comment">{{ __('Observações', 'reservafrota') }}</label>
                    <textarea class="form-control" id="driver-comment" name="comment" rows="2" {% if readonly %}readonly{% endif %}>{{ item.fields['comment'] }}</textarea>
                </div>

                <div class="reservafrota-formactions">
                    {% if can_edit %}
                        {% if is_new %}
                            <button type="submit" name="add" value="1" class="btn btn-primary"><i class="ti ti-plus"></i> {{ __('Cadastrar motorista', 'reservafrota') }}</button>
                        {% else %}
                            <button type="submit" name="update" value="1" class="btn btn-primary"><i class="ti ti-device-floppy"></i> {{ _x('button', 'Save') }}</button>
                            <button type="submit" name="purge" value="1" class="btn btn-outline-danger" onclick="return confirm('{{ __('Excluir definitivamente este motorista?', 'reservafrota') }}');"><i class="ti ti-trash"></i> {{ _x('button', 'Delete permanently') }}</button>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </form>

    {% if history is defined and history is not empty %}
    <section class="reservafrota-carhistory reservafrota-tablefilter">
        <h3 class="reservafrota-carhistory__title"><i class="ti ti-history"></i> {{ __('Últimas modificações', 'reservafrota') }}</h3>
        <div class="reservafrota-filters">
            <label>{{ __('Data', 'reservafrota') }}<input type="date" class="cb-f-date form-control"></label>
            <label>{{ __('A partir da hora', 'reservafrota') }}<input type="time" class="cb-f-time form-control"></label>
            <button type="button" class="reservafrota-clearbtn cb-f-clear" style="align-self:flex-end;"><i class="ti ti-eraser"></i> {{ __('Limpar', 'reservafrota') }}</button>
        </div>
        <div class="reservafrota-tablewrap">
            <table class="reservafrota-arrived-table reservafrota-histtable">
                <thead><tr><th>{{ __('Data', 'reservafrota') }}</th><th>{{ __('Usuário', 'reservafrota') }}</th><th>{{ __('Campo', 'reservafrota') }}</th><th>{{ __('Atualização', 'reservafrota') }}</th></tr></thead>
                <tbody>
                {% for h in history %}
                    <tr data-date="{{ h.date|slice(0,10) }}" data-time="{{ h.date|slice(11,5) }}"><td><b>{{ h.date }}</b></td><td>{{ h.user }}</td><td>{{ h.field ?: '—' }}</td><td>{{ h.change|raw }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% endif %}
</div>
